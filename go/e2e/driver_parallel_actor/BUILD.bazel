load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

# driver_parallel_actor exercises the Parallel Actor programming model end to
# end as a standalone driver binary, so it can be submitted via
# `ray job submit`.
#
# Usage:
#   bazel build //go/e2e/userfuncs/plugin:userfuncs_plugin
#   bazel build //go/e2e/driver_parallel_actor
#   mkdir -p job_dir
#   cp bazel-bin/go/e2e/userfuncs/plugin/userfuncs.so job_dir/
#   cp bazel-bin/go/e2e/driver_parallel_actor_/driver_parallel_actor job_dir/
#   cd job_dir && ray job submit --working-dir . -- ./driver_parallel_actor
go_binary(
    name = "driver_parallel_actor",
    embed = [":driver_parallel_actor_lib"],
    # Strip symbol table and DWARF debug info to shrink the uploaded package.
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "github.com/ray-project/ray/go/e2e/driver_parallel_actor",
    visibility = ["//visibility:public"],
)

go_library(
    name = "driver_parallel_actor_lib",
    srcs = ["main.go"],
    importpath = "github.com/ray-project/ray/go/e2e/driver_parallel_actor",
    visibility = ["//visibility:private"],
    deps = [
        "//go/e2e/userfuncs",
        "//go/pkg/options",
        "//go/pkg/runtime/api",
    ],
)
