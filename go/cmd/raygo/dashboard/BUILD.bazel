load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# The dashboard library provides the dashboard subcommand for the Ray Go CLI,
# which starts the Ray dashboard head process.
go_library(
    name = "dashboard",
    srcs = ["dashboard.go"],
    importpath = "github.com/ray-project/ray/go/cmd/raygo/dashboard",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/dashboard/head",
        "//go/internal/dashboard/head/modules/data",
        "//go/internal/dashboard/head/modules/event",
        "//go/internal/dashboard/head/modules/flow",
        "//go/internal/dashboard/head/modules/insight",
        "//go/internal/dashboard/head/modules/job",
        "//go/internal/dashboard/head/modules/log",
        "//go/internal/dashboard/head/modules/metrics",
        "//go/internal/dashboard/head/modules/node",
        "//go/internal/dashboard/head/modules/reporter",
        "//go/internal/dashboard/head/modules/serve",
        "//go/internal/dashboard/head/modules/state",
        "//go/internal/dashboard/head/modules/train",
        "//go/internal/dashboard/head/modules/usage_stats",
        "//go/internal/runtime_env",
        "//go/pkg/log",
        "//go/pkg/log/logconfig",
        "//go/pkg/log/zap",
        "//go/pkg/runtime/plugin",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "dashboard_test",
    srcs = ["dashboard_test.go"],
    embed = [":dashboard"],
    deps = [
        "@com_github_spf13_cobra//:cobra",
    ],
)
