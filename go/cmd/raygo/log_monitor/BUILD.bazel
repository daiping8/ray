load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# The log_monitor library provides the log-monitor subcommand for the Ray Go
# CLI, used to ship node logs to the GCS log aggregator.
go_library(
    name = "log_monitor",
    srcs = ["log_monitor.go"],
    importpath = "github.com/ray-project/ray/go/cmd/raygo/log_monitor",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/common",
        "//go/internal/gcs/native",
        "//go/internal/logmonitor",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log/lumberjack",
        "//go/pkg/log/zap",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "log_monitor_test",
    srcs = ["log_monitor_test.go"],
    embed = [":log_monitor"],
    deps = [
        "//go/pkg/gcs",
        "//go/pkg/log",
        "@com_github_spf13_cobra//:cobra",
    ],
)
