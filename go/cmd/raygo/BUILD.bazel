load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "raygo_lib",
    srcs = ["raygo.go"],
    importpath = "github.com/ray-project/ray/go/cmd/raygo",
    visibility = ["//visibility:private"],
    deps = [
        "//go/cmd/raygo/autoscaler/monitor",
        "//go/cmd/raygo/dashboard",
        "//go/cmd/raygo/dashboard_agent",
        "//go/cmd/raygo/default_worker",
        "//go/cmd/raygo/log_monitor",
        "//go/cmd/raygo/runtime_env_agent",
        "//go/cmd/raygo/setup_worker",
        "//go/cmd/raygo/version",
        "//go/pkg/log",
        "//go/pkg/log/zap",
        "//go/pkg/version",
        "@com_github_spf13_cobra//:cobra",
    ],
)

# raygo executable. x_defs bakes the version package's version/commit into the
# binary at link time (-ldflags -X), aligned with python/ray/_version.py's
# build-time {{RAY_COMMIT_SHA}} placeholder substitution. The default value is
# the {{RAY_COMMIT_SHA}} placeholder (no injected signal, matching _version.py's
# commit); the wheel build script replaces version.RayCommit with the real
# TRAVIS_COMMIT via sed before compilation.
go_binary(
    name = "raygo",
    embed = [":raygo_lib"],
    # Strip the symbol table (-s) and the DWARF debug info (-w) to keep the
    # shipped raygo binary small.
    gc_linkopts = [
        "-s",
        "-w",
    ],
    visibility = ["//visibility:public"],
    x_defs = {
        "github.com/ray-project/ray/go/pkg/version.RayVersion": "3.0.0.dev0",
        "github.com/ray-project/ray/go/pkg/version.RayCommit": "{{RAY_COMMIT_SHA}}",
    },
)
