load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# The runtime_env_agent library provides the runtime-env-agent subcommand for
# the Ray Go CLI, which runs the node-level runtime environment agent.
go_library(
    name = "runtime_env_agent",
    srcs = ["runtime_env_agent.go"],
    importpath = "github.com/ray-project/ray/go/cmd/raygo/runtime_env_agent",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/common",
        "//go/internal/gcs/native",
        "//go/internal/runtime_env",
        "//go/internal/runtime_env/agent",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/log/zap",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "runtime_env_agent_test",
    srcs = ["runtime_env_agent_test.go"],
    embed = [":runtime_env_agent"],
    deps = [
        "//go/pkg/gcs",
        "//go/pkg/gcs/mockgcs",
    ],
)
