load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "monitor",
    srcs = ["monitor.go"],
    importpath = "github.com/ray-project/ray/go/cmd/raygo/autoscaler/monitor",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/autoscaler/v2:autoscaler",
        "//go/internal/autoscaler/v2/constant",
        "//go/internal/common",
        "//go/pkg/log",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "monitor_test",
    srcs = ["monitor_test.go"],
    embed = [":monitor"],
    deps = [
        "//go/internal/autoscaler/v2:autoscaler",
        "//go/internal/autoscaler/v2/constant",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_stretchr_testify//assert",
    ],
)
