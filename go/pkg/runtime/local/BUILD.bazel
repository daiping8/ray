load("@io_bazel_rules_go//go:def.bzl", "go_library")

# Public adapter for the local (in-process) runtime. It is a thin layer that
# imports the internal local_mode implementation so its init() registers the
# local-mode initializer with the api layer. No cgo: this package links no C++
# core worker or gRPC, so importing it into a driver keeps the binary clean of
# the "linked both statically and dynamically" plugin conflict.
go_library(
    name = "local",
    srcs = ["register.go"],
    importpath = "github.com/ray-project/ray/go/pkg/runtime/local",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/runtime/local_mode",
    ],
)
