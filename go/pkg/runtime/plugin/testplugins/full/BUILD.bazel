# surface go/cmd/plugin, which takes base.RuntimeHandle). Used to exercise the
# successful plugin load path in plugin_loader_gcs_test.
ray_go_testplugin(
    name = "full",
    out = "testplugin_full.so",
    importpath = "github.com/ray-project/ray/go/pkg/runtime/plugin/testplugins/full",
    deps = [
        "//go/internal/runtime/base",
        "//go/pkg/gcs",
        "//go/pkg/options",
        "//go/pkg/runtime/contract",
    ],
)
