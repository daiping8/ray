# gazelle:ignore
load("//go/pkg/runtime/plugin/testplugins:defs.bzl", "ray_go_testplugin")

# Typed-nil test plugin: exports the full 5-symbol surface with valid
# signatures, but Initialize returns a typed-nil *nilHandle (non-nil interface,
# nil error). Used to exercise the loader's typed-nil rejection path in
# plugin_loader_gcs_test.
ray_go_testplugin(
    name = "typednil",
    out = "testplugin_typednil.so",
    importpath = "github.com/ray-project/ray/go/pkg/runtime/plugin/testplugins/typednil",
    deps = [
        "//go/internal/runtime/base",
        "//go/pkg/gcs",
        "//go/pkg/options",
        "//go/pkg/runtime/contract",
    ],
)
