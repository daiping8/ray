        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/submitter",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_github_vmihailenco_msgpack_v5//:msgpack",
        "@org_golang_google_protobuf//proto",
    ],
)

# Runtime-accessor tests gated behind the "apiinternal" build tag because they
# assume the package-global handle state is unset.
go_test(
    name = "api_internal_test",
    srcs = ["internal_test.go"],
    embed = [":api"],
    gotags = ["apiinternal"],
)

# Re-init lifecycle tests, gated behind the "apireinit" build tag because
# setHandle mutates package-global handle state (currentHandle) that the default
# api tests assume is unset.
go_test(
    name = "api_reinit_test",
    srcs = ["handle_reinit_test.go"],
    embed = [":api"],
    gotags = ["apireinit"],
    deps = [
        "//go/pkg/runtime/contract",
    ],
)

# ActorHandle.Kill / KillWithNoRestart instance-method tests, gated behind the
# "apikill" build tag because storeHandleLocked mutates package-global handle
# state (currentHandle) that the default api tests assume is unset. It uses its
# own tag (rather than sharing "apiinternal") because it stores a distinct fake
# handle type into the shared atomic.Value currentHandle, which would panic
# ("store of inconsistently typed value") if run in the same test binary as
# internal_test.go.
go_test(
    name = "api_actor_kill_test",
    srcs = ["actor_kill_test.go"],
    embed = [":api"],
    gotags = ["apikill"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/submitter",
    ],
)

# Local-mode init tests gated behind the "apilocalinit" build tag because
