load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Public API library for Ray Go Runtime
# Consistent with Java Ray API (io.ray.api.Ray)
go_library(
    name = "api",
    srcs = [
        "actor.go",
        "api.go",
        "call.go",
        "factory.go",
        "gcs_client.go",  # NEW: GCS client interface and factory
        "handle.go",
        "internal.go",
        "method_extractor.go",
        "object.go",
        "object_id_generator.go",
        "options.go",
        "parallel_actor.go",
        "placement_group.go",
        "ray.go",
        "resource_ids.go",
        "runtime.go",
        "runtime_env.go",
    ],
    importpath = "github.com/ray-project/ray/go/pkg/runtime/api",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/errors",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/log/logconfig",
        "//go/pkg/options",
        "//go/pkg/pathutil",
        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/plugin",
        "//go/pkg/runtime/submitter",
        "//go/proto",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Unit tests for API
go_test(
