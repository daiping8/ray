        "actor_get_python_test.go",
        "actor_registration_test.go",
        "actor_task_arity_test.go",
        "api_test.go",
        "call_convert_arg_test.go",
        "call_test.go",
        "cpp_call_test.go",
        "driver_logger_test.go",
        "example_test.go",
        "gcs_client_test.go",
        "handle_release_test.go",
        "method_extractor_test.go",
        "object_id_generator_test.go",
        "object_ref_test.go",
        "options_test.go",
        "parallel_actor_test.go",
        "python_call_test.go",
        "ray_job_config_env_test.go",
        "task_return_ref_test.go",
    ],
    embed = [":api"],
    deps = [
        "//go/pkg/errors",
        "//go/pkg/gcs",
        "//go/pkg/ids",
