load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Public API library for Ray custom metrics.
# The concrete backend (e.g. cgo.CgoMetricBackend) is injected from go/internal
# or tests via SetBackend, keeping this package free of internal dependencies.
go_library(
    name = "metric",
    srcs = ["metric.go"],
    importpath = "github.com/ray-project/ray/go/pkg/runtime/metric",
    visibility = ["//visibility:public"],
)

go_test(
    name = "metric_test",
    srcs = ["metric_test.go"],
    embed = [":metric"],
    importpath = "github.com/ray-project/ray/go/pkg/runtime/metric",
)
