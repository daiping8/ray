load("@bazel_gazelle//:def.bzl", "gazelle")
load("@py_deps_py310//:requirements.bzl", ci_require = "requirement")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

# gazelle:prefix github.com/ray-project/ray/go
gazelle(
    name = "gazelle",
    args = ["go"],
    prefix = "github.com/ray-project/ray/go",
)

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go/go.mod",
        "-to_macro=go/dependencies.bzl%gazelle_dependencies",
    ],
    command = "update-repos",
)

# Package the raygo executable CLI tool (referenced from go/cmd/raygo/BUILD.bazel).
pkg_files(
    name = "raygo_executable_files",
    srcs = ["//go/cmd/raygo"],
    attributes = pkg_attributes(mode = "755"),
    prefix = "ray/go/cmd",
    visibility = ["//visibility:private"],
)

# Package the go_runtime.so shared library (referenced from go/cmd/plugin/BUILD.bazel).
# Note: go_runtime.so is built in plugin mode.
pkg_files(
    name = "go_runtime_so_files",
    srcs = ["//go/cmd/plugin:go_runtime_so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "ray/go/lib",
    visibility = ["//visibility:private"],
)

# Package the default runtime_env JSON schemas that plugin_schema_manager.go
# reads at runtime. Without shipping these, the schema directory resolved from
# the installed raygo layout does not exist and plugin validation silently finds
# no schemas.
pkg_files(
    name = "runtime_env_schema_files",
    srcs = ["//go/internal/runtime_env:schemas"],
    prefix = "ray/go/internal/runtime_env/schemas",
    visibility = ["//visibility:private"],
)

# The final zip archive contains the Go runtime artifacts:
# 1. raygo - executable CLI tool (cmd directory)
# 2. go_runtime.so - Go Runtime plugin shared library (lib directory)
# 3. runtime_env JSON schemas (internal/runtime_env/schemas directory)
pkg_zip(
    name = "ray_go_pkg_zip",
    srcs = [
        ":go_runtime_so_files",
        ":raygo_executable_files",
        ":runtime_env_schema_files",
    ],
    out = "ray_go_pkg.zip",
    visibility = ["//visibility:public"],
)

# gen_ray_go_pkg Python script - extracts ray_go_pkg.zip into python/ray/go/.
py_binary(
    name = "gen_ray_go_pkg",
    srcs = ["gen_ray_go_pkg.py"],
    data = [
        ":check_pkghash",
        ":ray_go_pkg_zip",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//bazel:gen_extract",
        "//go:check_pkghash",
    ],
)

# D4: readelf-based package-hash check (pkghashbytes.*runtime/api) - build-time
# verification that raygo and go_runtime.so are built from the same source
# revision, preventing Go plugin version mismatches.
py_binary(
    name = "check_pkghash",
    srcs = ["check_pkghash.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "check_pkghash_test",
    size = "small",
    srcs = [
        "check_pkghash_test.py",
        "//bazel:pytest_wrapper.py",
    ],
    args = [
        "$(location check_pkghash_test.py)",
    ],
    data = [
        "//go/cmd/raygo",
    ],
    main = "//bazel:pytest_wrapper.py",
    deps = [
        ":check_pkghash",
        ci_require("pytest"),
    ],
)
