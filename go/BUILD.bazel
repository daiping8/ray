load("@bazel_gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/ray-project/ray/go
gazelle(
    name = "gazelle",
    args = ["go"],
    prefix = "github.com/ray-project/ray",
)

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go/go.mod",
        "-to_macro=go/dependencies.bzl%gazelle_dependencies",
    ],
    command = "update-repos",
)