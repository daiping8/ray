load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# proctitle mirrors Python's setproctitle / C++'s process_title_guard for Go
# workers. Pure cgo: the C kernel is embedded in the .go file preamble (CDEFS),
# with no separate .c/.h dependency.
go_library(
    name = "proctitle",
    srcs = [
        "proctitle.go",
    ],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/proctitle",
    visibility = ["//go:__subpackages__"],
)

go_test(
    name = "proctitle_test",
    srcs = [
        "proctitle_test.go",
    ],
    embed = [":proctitle"],
    importpath = "github.com/ray-project/ray/go/internal/proctitle",
)
