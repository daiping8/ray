load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# localstore package: the pure-Go in-memory object store for local mode.
#
# Split out of the cgo objectstore package: LocalModeObjectStore is used only
# by the local_mode runtime, and keeping it in objectstore forced local_mode to
# statically link the C++ core worker. This package has no cgo dependencies.
go_library(
    name = "localstore",
    srcs = ["local_mode_object_store.go"],
    importpath = "github.com/ray-project/ray/go/internal/runtime/localstore",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/runtime/object",
    ],
)

# Unit tests for the pure-Go local-mode object store (no running cluster
# required).
go_test(
    name = "localstore_test",
    srcs = ["local_mode_object_store_test.go"],
    embed = [":localstore"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/runtime/object",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
