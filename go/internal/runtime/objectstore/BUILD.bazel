load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Object store implementations.
# This package contains the CGO-based NativeObjectStore implementation.
# LocalModeObjectStore (pure Go) lives in //go/internal/runtime/localstore so
# that the local-mode runtime does not statically link the C++ core worker.
go_library(
    name = "objectstore",
    srcs = ["native_object_store.go"],
    cdeps = [
        "//src/ray/core_worker/lib/go:native_runtime",
        "//src/ray/core_worker/lib/go:native_runtime_go_headers",
    ],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/runtime/objectstore",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/runtime/object",
        "//go/proto",
        "@org_golang_google_protobuf//proto",
    ],
)

# Unit tests for the CGO-based native store (they cover constructor wiring and
# the empty-input paths of the native calls, so no running cluster is
# required). The pure-Go local-mode store tests live in
# //go/internal/runtime/localstore.
go_test(
    name = "objectstore_test",
    srcs = ["native_object_store_test.go"],
    embed = [":objectstore"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/runtime/object",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
