load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reporter",
    srcs = [
        "collector.go",
        "consts.go",
        "gpu_collector.go",
        "k8s_adapter.go",
        "metrics_service.go",
        "module.go",
        "payload.go",
        "profile.go",
        "reporter_service.go",
        "tpu_collector.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/dashboard/reporter",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/dashboard/agent",
        "//go/pkg/gcs",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_prometheus_client_golang//prometheus",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "reporter_test",
    srcs = [
        "collector_fix_test.go",
        "collector_test.go",
        "consts_test.go",
        "gpu_collector_test.go",
        "k8s_adapter_test.go",
        "metrics_service_test.go",
        "module_test.go",
        "payload_test.go",
        "profile_test.go",
        "reporter_service_test.go",
        "resolve_publisher_test.go",
        "tpu_collector_test.go",
    ],
    embed = [":reporter"],
    deps = [
        "//go/internal/dashboard/agent",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_go_logr_logr//:logr",
        "@com_github_prometheus_client_golang//prometheus",
        "@org_golang_google_grpc//:go_default_library",
    ],
)
