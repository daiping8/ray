load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "logmonitor",
    srcs = [
        "file_info.go",
        "monitor.go",
        "patterns.go",
        "process.go",
        "publisher.go",
        "runtime_publisher.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/logmonitor",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/gcs",
        "//go/pkg/log",
    ],
)

go_test(
    name = "logmonitor_test",
    srcs = [
        "integration_monitor_test.go",
        "monitor_lifecycle_test.go",
        "monitor_read_test.go",
        "monitor_rotation_test.go",
        "patterns_test.go",
        "python_parity_test.go",
        "real_session_replay_test.go",
        "runtime_publisher_test.go",
        "test_helpers_test.go",
    ],
    data = [
        "testdata/parity_scenarios.json",
        "testdata/python_parity_runner.py",
        "testdata/real_session_logs/README.md",
        "testdata/real_session_replay_runner.py",
        "//python/ray/_private:log_monitor.py",
    ],
    embed = [":logmonitor"],
    importpath = "github.com/ray-project/ray/go/internal/logmonitor",
    deps = ["//go/pkg/gcs"],
)
