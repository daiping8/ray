load("@io_bazel_rules_go//go:def.bzl", "go_test")

# End-to-end tests against a real Ray cluster. TestMain starts and stops that
# cluster, so the target is opt-in: it carries the manual tag to stay out of
# wildcard runs and every test skips unless RAY_GCS_INTEGRATION_TESTS=1.
go_test(
    name = "integration_test",
    srcs = ["e2e_test.go"],
    tags = [
        "integration",
        "local",
        "manual",
        "requires-gcs",
    ],
    deps = [
        "//go/internal/gcs/native",
        "//go/internal/gcs/testenv",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
