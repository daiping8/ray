load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "agent",
    srcs = [
        "http_server.go",
        "runtime_env_agent.go",
        "runtime_env_consts.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/runtime_env/agent",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/common",
        "//go/internal/runtime_env",
        "//go/pkg/gcs",
        "//go/pkg/log",
        "//go/pkg/log/zap",
        "//go/proto",
        "@com_github_go_logr_logr//:logr",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_sync//errgroup",
        "@org_uber_go_zap//zapcore",
    ],
)

go_test(
    name = "agent_test",
    srcs = [
        "http_server_test.go",
        "runtime_env_agent_test.go",
        "runtime_env_consts_test.go",
    ],
    embed = [":agent"],
    deps = [
        "//go/internal/runtime_env",
        "//go/pkg/gcs/mockgcs",
        "//go/proto",
        "@org_golang_google_protobuf//proto",
    ],
)
