load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# The cloud storage download implementations (GS, S3, Azure Blob Storage and
# ABFSS; protocol_cloud.go) pull the google cloud auth/proto chain and the AWS
# and Azure SDKs into the dependency graph. The Azure SDK's azcore graph has a
# known repository visibility conflict in this workspace, and the google cloud
# chain (s2a-go proto packages) is not compilable under this bazel setup, so
# they are only built with the "cloud" Go build tag. In bazel, rules_go
# forwards the "gotags" --define to the Go compiler, so a single flag selects
# the sources and activates the //go:build constraints:
#   bazel build //go/... --define gotags=cloud
# Default builds compile protocol_cloud_stub.go instead, whose handlers return
# a descriptive error, keeping those dependencies out of the default build.
config_setting(
    name = "cloud_build",
    values = {"define": "gotags=cloud"},
)

go_library(
    name = "runtime_env",
    srcs = [
        "accessors.go",
        "conda.go",
        "conda_utils.go",
        "context.go",
        "dependency_utils.go",
        "image_uri.go",
        "internal_kv.go",
        "java_jars.go",
        "logging_utils.go",
        "merge.go",
        "nsight.go",
        "packaging.go",
        "packaging_types.go",
        "packaging_utils.go",
        "pip.go",
        "plugin.go",
        "protocol.go",
        "py_executable.go",
        "py_modules.go",
        "python_utils.go",
        "rocprof_sys.go",
        "runtime_env.go",
        "runtime_env_config.go",
        "types.go",
        "uri_cache.go",
        "utils.go",
        "uv.go",
        "validation.go",
