        "working_dir.go",
    ] + select({
        ":cloud_build": ["protocol_cloud.go"],
        "//conditions:default": ["protocol_cloud_stub.go"],
    }),
    importpath = "github.com/ray-project/ray/go/internal/runtime_env",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/common",
        "//go/pkg/gcs",
        "//go/pkg/log",
        "//go/pkg/log/lumberjack",
        "//go/pkg/log/zap",
        "//go/proto",
        "@com_github_go_logr_logr//:logr",
        "@com_github_google_uuid//:uuid",
        "@com_github_mohae_deepcopy//:deepcopy",
        "@com_github_sabhiram_go_gitignore//:go-gitignore",
        "@dev_al_essio_pkg_shellescape//:shellescape",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_uber_go_zap//zapcore",
    ] + select({
        ":cloud_build": [
            "@com_github_aws_aws_sdk_go_v2//aws",
            "@com_github_aws_aws_sdk_go_v2_config//:config",
            "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
            "@com_github_azure_azure_sdk_for_go_sdk_azidentity//:azidentity",
            "@com_github_azure_azure_sdk_for_go_sdk_storage_azblob//:azblob",
            "@com_github_azure_azure_sdk_for_go_sdk_storage_azdatalake//service",
            "@org_golang_google_api//option",
            "@org_golang_google_api//storage/v1:storage",
            "@org_golang_x_oauth2//google",
        ],
        "//conditions:default": [],
    }),
)

