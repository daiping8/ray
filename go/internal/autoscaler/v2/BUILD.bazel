load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "autoscaler",
    srcs = [
        "autoscaler.go",
        "event_logger.go",
        "metrics_reporter.go",
        "monitor.go",
        "monitor_config.go",
        "util.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/v2",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/v2/constant",
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/internal/autoscaler/v2/instance_manager/cloud_providers",
        "//go/internal/autoscaler/v2/instance_manager/reconciler",
        "//go/internal/autoscaler/v2/instance_manager/subscribers",
        "//go/internal/autoscaler/v2/scheduler",
        "//go/internal/autoscaler/v2/service",
        "//go/internal/common",
        "//go/internal/common/usage",
        "//go/internal/event",
        "//go/internal/gcs/native",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//proto",
    ],
)

