load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "scheduler",
    srcs = [
        "resource_demand_scheduler.go",
        "scheduler.go",
        "scheduling_node.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/v2/scheduler",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "scheduler_test",
    srcs = ["scheduler_test.go"],
    embed = [":scheduler"],
    deps = [
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
    ],
)
