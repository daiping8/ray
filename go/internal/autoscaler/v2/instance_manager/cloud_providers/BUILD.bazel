load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cloud_providers",
    srcs = [
        "local_provider.go",
        "readonly_provider.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/v2/instance_manager/cloud_providers",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/local",
        "//go/pkg/gcs",
        "//go/pkg/log",
        "//go/proto",
    ],
)

go_test(
    name = "readonly_provider_test",
    srcs = ["readonly_provider_test.go"],
    embed = [":cloud_providers"],
    deps = [
        "//go/internal/autoscaler",
        "//go/pkg/gcs",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "local_provider_test",
    srcs = ["local_provider_test.go"],
    embed = [":cloud_providers"],
    deps = [
        "//go/proto",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "cloud_providers_test",
    srcs = [
        "local_provider_test.go",
        "readonly_provider_test.go",
    ],
    embed = [":cloud_providers"],
    deps = [
        "//go/internal/autoscaler",
        "//go/pkg/gcs",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
    ],
)
