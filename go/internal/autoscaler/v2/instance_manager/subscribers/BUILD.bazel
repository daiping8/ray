load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "subscribers",
    srcs = [
        "cloud_instance_updater.go",
        "cloud_resource_monitor.go",
        "ray_install_error.go",
        "ray_stopper.go",
        "ssh_ray_installer.go",
        "threaded_ray_installer.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/v2/instance_manager/subscribers",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/agent",
    ],
)

go_test(
    name = "subscribers_test",
    srcs = [
        "cloud_instance_updater_test.go",
        "cloud_resource_monitor_test.go",
        "ray_stopper_test.go",
        "ssh_ray_installer_test.go",
        "threaded_ray_installer_test.go",
    ],
    embed = [":subscribers"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_crypto//ssh",
    ],
)
