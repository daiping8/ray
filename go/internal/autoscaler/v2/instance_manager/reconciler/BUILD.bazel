load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reconciler",
    srcs = [
        "active_scaling.go",
        "passive_sync.go",
        "reconciler.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/v2/instance_manager/reconciler",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/internal/autoscaler/v2/instance_manager/subscribers",
        "//go/internal/autoscaler/v2/scheduler",
        "//go/pkg/log",
        "//go/proto",
    ],
)

go_test(
    name = "reconciler_test",
    srcs = ["reconciler_test.go"],
    embed = [":reconciler"],
    deps = [
        "//go/internal/autoscaler",
        "//go/internal/autoscaler/v2/instance_manager",
        "//go/internal/autoscaler/v2/instance_manager/subscribers",
        "//go/internal/autoscaler/v2/scheduler",
        "//go/proto",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
