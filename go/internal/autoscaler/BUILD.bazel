load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "autoscaler",
    srcs = [
        "autoscaler.go",
        "autoscaler_consts.go",
        "docker.go",
        "map_utils.go",
        "node_provider_errors.go",
        "prom_metrics.go",
        "providers.go",
        "utils.go",
    ],
    embedsrcs = ["ray-schema.json"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/autoscaler/fake_multi_node",
        "//go/internal/autoscaler/local",
        "//go/internal/autoscaler/readonly",
        "//go/internal/common",
        "//go/pkg/log",
        "//go/proto",
        "@com_github_mohae_deepcopy//:deepcopy",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_xeipuuv_gojsonschema//:gojsonschema",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "docker_test",
    srcs = ["docker_test.go"],
    embed = [":autoscaler"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/docker_test",
    deps = [
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "map_utils_test",
    srcs = ["map_utils_test.go"],
    embed = [":autoscaler"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/map_utils_test",
    deps = [
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "providers_test",
    srcs = ["providers_test.go"],
    embed = [":autoscaler"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/providers_test",
    deps = [
        "@com_github_stretchr_testify//assert",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "utils_test",
    srcs = ["utils_test.go"],
    embed = [":autoscaler"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/utils_test",
    deps = [
        "//go/proto",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "prom_metrics_test",
    srcs = ["prom_metrics_test.go"],
    embed = [":autoscaler"],
    importpath = "github.com/ray-project/ray/go/internal/autoscaler/prom_metrics_test",
    deps = [
        "@com_github_prometheus_client_model//go",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "autoscaler_test",
    srcs = [
        "docker_test.go",
        "map_utils_test.go",
        "prom_metrics_test.go",
        "providers_test.go",
        "utils_test.go",
    ],
    embed = [":autoscaler"],
    deps = [
        "//go/proto",
        "@com_github_mohae_deepcopy//:deepcopy",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_model//go",
        "@com_github_stretchr_testify//assert",
    ],
)
