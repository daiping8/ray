load("@io_bazel_rules_go//go:def.bzl", "go_binary")

# driver_app is a Ray Go driver application that submits tasks to a Ray cluster.
#
# It exercises the driver-side public API end to end: task submission via the
# userfuncs package, the Wait API, concurrent submission, KillActor, the
# cross-process zero-copy Get path and pass-by-reference task arguments.
#
# Usage:
#   bazel build //go/examples/userfuncs/plugin:userfuncs_plugin
#   bazel build //go/examples:driver_app
#   mkdir -p job_dir
#   cp bazel-bin/go/examples/userfuncs/plugin/userfuncs.so job_dir/
#   cp bazel-bin/go/examples/driver_app_/driver_app job_dir/
#   cd job_dir && ray job submit --working-dir . -- ./driver_app
#
# Or run it without a cluster: ./driver_app --run-mode=local
go_binary(
    name = "driver_app",
    srcs = ["driver_app.go"],
    # Strip symbol table and DWARF debug info to shrink the uploaded package.
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "github.com/ray-project/ray/go/examples/driver_app",
    visibility = ["//visibility:public"],
    deps = [
        "//go/examples/userfuncs",
        "//go/pkg/log",
        "//go/pkg/log/zap",
        "//go/pkg/options",
        "//go/pkg/runtime/api",
        "//go/pkg/runtime/local",
    ],
)
